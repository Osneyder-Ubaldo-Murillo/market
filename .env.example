# ==================================================================
# NexusMarket - Variables de entorno para despliegue
# Copia este archivo a .env y ajusta los valores antes de desplegar
# ==================================================================

# --- Base de datos MySQL ---
# OBLIGATORIAS y sin valores por defecto: genere contraseñas propias, distintas entre sí,
# p. ej. con: openssl rand -hex 16. La aplicación rechaza contraseñas de ejemplo
# (root, nexus, password...). MYSQL_USER es el usuario con el que se conecta la app.
MYSQL_ROOT_PASSWORD=
MYSQL_DATABASE=nexusmarket
MYSQL_USER=
MYSQL_PASSWORD=

# --- Base de datos MongoDB (auditoría) ---
# OBLIGATORIAS. Use solo caracteres seguros en URI (p. ej. openssl rand -hex 16).
MONGO_USER=
MONGO_PASSWORD=

# --- JWT (OBLIGATORIO: cambiar en producción) ---
# Minimo 32 bytes, aleatorio: openssl rand -base64 48
# La aplicacion NO arranca con secretos de ejemplo, cortos o vacios.
JWT_SECRET=
JWT_ISSUER=nexusmarket
JWT_EXPIRATION=86400000

# --- Origenes CORS permitidos (separados por coma, EXACTOS, sin comodines) ---
# Vacio = ningun origen cruzado. Indicar el dominio real del frontend al desplegar,
# p. ej.: CORS_ALLOWED_ORIGINS=https://tienda.ejemplo.com
CORS_ALLOWED_ORIGINS=

# --- Proxies inversos de confianza (opcional) ---
# Solo si la aplicación está detrás de un proxy propio: lista de IP o CIDR separados por coma (p. ej. 10.0.0.5,172.16.0.0/12).
# Solo la conexión que venga de ellos puede indicar la IP real del cliente con X-Forwarded-For. Vacío = no se confía en ninguna
# cabecera (la IP del cliente es la de la conexión). Un valor no válido o un /0 impide arrancar.
TRUSTED_PROXIES=

# --- Pago simulado (BLOQUEADO por defecto en producción) ---
# La única pasarela del proyecto es una simulación que NO cobra. Con el perfil prod la aplicación no arranca
# mientras esto no sea "true": declárelo solo en un despliegue académico o de demostración.
NEXUSMARKET_PAYMENT_SIMULATED_ALLOWED=false

# --- Transportadora simulada (BLOQUEADA por defecto en producción) ---
# La única transportadora del proyecto es una simulación: genera un seguimiento ficticio y no crea envíos reales. Con el perfil
# prod la aplicación no arranca mientras esto no sea "true": declárelo solo en un despliegue académico o de demostración.
NEXUSMARKET_SHIPPING_SIMULATED_ALLOWED=false

# --- Notificaciones por log (BLOQUEADAS por defecto en producción) ---
# El único adaptador del proyecto escribe en el log el contenido de cada notificación, incluidos los códigos de verificación
# de correo y de recuperación de contraseña: quien lea el log podría tomar una cuenta. Con el perfil prod la aplicación no
# arranca mientras esto no sea "true": declárelo solo en una demostración académica, nunca con usuarios reales.
NEXUSMARKET_NOTIFICATIONS_LOGGING_ALLOWED=false

# --- Administrador inicial (DESHABILITADO por defecto) ---
# Solo para el primer arranque controlado; ver market/docs/ADMIN_INICIAL_ACTIVACION.md. Sin valores por defecto.
# La contraseña se entrega preferentemente con un archivo de secreto (PASSWORD_FILE); no la escriba aquí.
NEXUSMARKET_BOOTSTRAP_ADMIN_ENABLED=false
NEXUSMARKET_BOOTSTRAP_ADMIN_EMAIL=
NEXUSMARKET_BOOTSTRAP_ADMIN_FULL_NAME=
NEXUSMARKET_BOOTSTRAP_ADMIN_DOCUMENT_ID=
NEXUSMARKET_BOOTSTRAP_ADMIN_PASSWORD_FILE=

# --- Swagger/OpenAPI (deshabilitado en produccion; true lo publica) ---
SWAGGER_ENABLED=false

# --- Actuator ---
MANAGEMENT_ENDPOINTS_WEB_EXPOSURE_INCLUDE=health,info,metrics
MANAGEMENT_ENDPOINT_HEALTH_SHOW_DETAILS=never

# --- Puerto de la app ---
SERVER_PORT=8080